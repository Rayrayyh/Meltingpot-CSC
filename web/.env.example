# MeltingPot environment variables.
#
# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git; this file is the only env file that is committed, so never put a real
# key in it. Every value below is a placeholder showing the shape, not a
# working credential.
#
# Only the Supabase pair is required. Everything else degrades on purpose: with
# a section left blank the feature it drives reports that it is not set up
# rather than crashing or showing a button that fails.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# public. Anything without that prefix stays on the server. Do not move a
# variable across that line to make something work.


# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------

# Project URL and anon key, from the project's API settings. The anon key is
# meant to be public: row level security on every table is the enforcement
# layer, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace-with-your-anon-key

# There is deliberately no service role key here. The deployed app never holds
# one: it would bypass row level security, and nothing in the app needs it.
# Run one-off admin SQL from the Supabase dashboard instead.

# Development containers only. Where browser TLS to Supabase is blocked but
# server-side Node traffic passes, setting this proxies the browser's Supabase
# calls same-origin through the Next server, and NEXT_PUBLIC_SUPABASE_URL then
# points at http://localhost:3111/supabase. Production leaves it unset and the
# browser talks to Supabase directly. See memory/lessons/004.
SUPABASE_REWRITE_ORIGIN=


# ---------------------------------------------------------------------------
# Identity provider
# ---------------------------------------------------------------------------

# meltingpots.xyz runs Clerk, and has since 2026-09-08. Set this to "clerk" to
# match it. Anything else, including unset, selects Supabase Auth, which is
# what local runs and the Playwright suite use: browser sign up there admits
# only @meltingpot.dev addresses. Both sit behind the same seam in
# lib/auth, so nothing above that layer knows which one is running.
#
# It is left blank here on purpose. Copying this file and filling in only the
# Supabase pair above gives you a working app on the Supabase path, whereas a
# default of "clerk" would hand you a broken one until the rest of the Clerk
# setup exists: a Clerk application, its two keys below, Supabase third-party
# auth pointed at that application, and migrations 0054 to 0057 applied.
# Steps in docs/CLERK.md, and the seam's contract in docs/AUTH.md.
NEXT_PUBLIC_AUTH_PROVIDER=

# Needed only when the line above says "clerk". From the Clerk dashboard, API
# keys. The publishable key also tells the content security policy which Clerk
# host to allow, so it is one variable rather than a hand-maintained list.
# A production instance issues pk_live_ and sk_live_ rather than the test
# prefixes shown here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-your-publishable-key
# Secret. Never prefix it with NEXT_PUBLIC_, and never commit a real one.
CLERK_SECRET_KEY=sk_test_replace-with-your-secret-key


# ---------------------------------------------------------------------------
# The model that mixes notes into study material
# ---------------------------------------------------------------------------

# Server-only key. Get one from https://aistudio.google.com/apikey
# Without it, or with either model name below left blank, the deterministic
# organizer carries every flow and the study tools report that mixing is
# unavailable. That is a supported state, not a broken one.
MODEL_API_KEY=

# The two models the live site runs on, so they are a safe place to start.
# FAST_MODEL stirs the pot: organizing, summaries, decks and practice tests.
# REASONING_MODEL writes the teaching readout. A blank name reads the same as
# no key at all, so the app never guesses a model name.
FAST_MODEL=gemini-3.6-flash
REASONING_MODEL=gemini-3.1-pro-preview

# The organizer seam's selector (lib/organizer). Leave it unset: the
# deterministic organizer runs by default, and the real model path is lib/mix
# behind MODEL_API_KEY above. The "claude" value names a slot whose organize()
# only throws not configured.
NEXT_PUBLIC_ORGANIZER_PROVIDER=


# ---------------------------------------------------------------------------
# Classwork from Canvas and Google Classroom
# ---------------------------------------------------------------------------
# All server-only; none of these carries NEXT_PUBLIC_. Availability is worked
# out on the server and handed to pages as props. With any of the shared three
# unset the whole feature reads as not set up on this site and every connect
# button says so. Each variable is validated on its own, so a malformed Canvas
# URL leaves Google Classroom working. See docs/CLASSWORK.md.

# Must match the deploy: the OAuth redirect URIs are built from it.
APP_ORIGIN=http://localhost:3111

# 32 bytes minimum, base64. Signs the OAuth state parameter.
# Generate with: openssl rand -base64 32
CLASSWORK_STATE_SECRET=

# 32 bytes minimum, base64. The same value goes into Supabase Vault as the
# secret named classwork_server_key. The database refuses token and import
# writes without it. Create the Vault copy in the SQL editor, not in a
# migration:  select vault.create_secret('<value>', 'classwork_server_key');
CLASSWORK_SERVER_KEY=

# Google Cloud OAuth web client with the Classroom API enabled. While the
# consent screen is in Testing, only named test users can connect and each
# consent lapses after seven days.
CLASSROOM_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
CLASSROOM_OAUTH_CLIENT_SECRET=

# Canvas developer key issued by a school's admin, and that school's Canvas
# host. Canvas forbids asking people for manually generated tokens, so this
# is the only supported route.
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_INSTANCE_URL=https://your-school.instructure.com

# "stub" points both providers at the local stub server the e2e suite runs,
# so the real adapters are exercised without touching Google or Canvas.
# "live" or unset talks to the real providers.
CLASSWORK_PROVIDER_MODE=
CLASSWORK_STUB_ORIGIN=http://localhost:3112

# 32 bytes minimum. The bearer the hourly Supabase cron sends to
# /api/classwork/sync-due. Stored in Vault as classwork_sync_trigger.
CLASSWORK_SYNC_TRIGGER_SECRET=


# ---------------------------------------------------------------------------
# Local tooling and tests (all optional)
# ---------------------------------------------------------------------------

# The row level security tests in lib/security/rls.test.ts sign in as a real
# user and skip themselves unless both of these are set. Use a throwaway
# account on a non-production project.
MP_TEST_EMAIL=
MP_TEST_PASSWORD=

# Chromium for Playwright and the icon build script. Defaults to the container
# path, so set it only if your browser lives somewhere else. Do not run
# "playwright install".
PW_CHROMIUM_PATH=

# Port for the stub LMS server used by the classwork e2e spec. Defaults to 3112,
# which is what CLASSWORK_STUB_ORIGIN above expects.
STUB_PORT=

# Origin the Clerk sign-in mockup script shoots against. Defaults to the live
# site, so set it to http://localhost:3111 to shoot locally instead.
CLERK_MOCKUP_ORIGIN=
