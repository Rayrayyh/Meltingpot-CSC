# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose: row level security is the enforcement layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identity provider. Unset or "supabase" uses Supabase Auth, which is what the
# live site runs on. "clerk" puts Clerk behind the same seam (lib/auth/clerk-client.ts and clerk-server.ts);
# it needs the two keys below, Supabase's third-party auth pointed at the Clerk
# application, and migrations 0054 to 0056 applied. Steps in docs/CLERK.md.
NEXT_PUBLIC_AUTH_PROVIDER=
# From the Clerk dashboard, API keys. The publishable key also tells the
# content security policy which Clerk host to allow.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-only key for the model that mixes notes into study material. Never
# prefix this with NEXT_PUBLIC_. Without it, and without both model names
# below, the deterministic organizer carries every flow and the study tools
# report that mixing is unavailable.
# Get one from https://aistudio.google.com/apikey
MODEL_API_KEY=
# The two models the live site runs on, so they are a safe place to start.
# FAST_MODEL stirs the pot: organizing, summaries and decks. REASONING_MODEL
# writes practice tests. Leaving either blank reads the same as no key at all,
# so the deterministic organizer takes over rather than the app guessing a name.
FAST_MODEL=gemini-3.6-flash
REASONING_MODEL=gemini-3.1-pro-preview

# Classwork from Canvas and Google Classroom. All server-only; none carries
# NEXT_PUBLIC_. With any of the shared three unset the feature reads as not set
# up on this site and every connect button says so. See docs/CLASSWORK.md.
# The exact redirect URIs are built from this, so it must match the deploy.
APP_ORIGIN=
# 32 random bytes, base64. Signs the OAuth state parameter.
CLASSWORK_STATE_SECRET=
# 32 random bytes, base64. The same value is stored in Supabase Vault as the
# secret named classwork_server_key; the database refuses token and import
# writes without it.
CLASSWORK_SERVER_KEY=
# Google Cloud OAuth web client with the Classroom API enabled.
CLASSROOM_OAUTH_CLIENT_ID=
CLASSROOM_OAUTH_CLIENT_SECRET=
# Canvas developer key from the school's admin, and that school's Canvas host.
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_INSTANCE_URL=
# "stub" points both providers at the local stub server for the e2e suite.
CLASSWORK_PROVIDER_MODE=
CLASSWORK_STUB_ORIGIN=http://localhost:3112
# Bearer the hourly Supabase cron sends to /api/classwork/sync-due.
CLASSWORK_SYNC_TRIGGER_SECRET=
